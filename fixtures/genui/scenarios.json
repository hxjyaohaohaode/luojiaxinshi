{
  "calculate": {
    "title": "时间试算 · 结果与参数联动",
    "intro": "根据每天 2 小时、准备 7 天这两个示例输入，可安排 14 小时。调整后立即重新计算。",
    "ops": [
      {
        "op": "begin",
        "v": 1
      },
      {
        "op": "state",
        "set": {
          "hours": 2,
          "days": 7
        }
      },
      {
        "op": "node",
        "id": "root",
        "type": "Stack",
        "children": [
          "summary",
          "details"
        ]
      },
      {
        "op": "node",
        "id": "summary",
        "type": "Grid",
        "props": {
          "columns": 2
        },
        "children": [
          "total",
          "inputs"
        ]
      },
      {
        "op": "node",
        "id": "total",
        "type": "Stat",
        "props": {
          "label": "可安排的准备时间",
          "value": {
            "$expr": "round(hours*days,1)"
          },
          "unit": "小时",
          "description": "按当前输入估算"
        }
      },
      {
        "op": "node",
        "id": "inputs",
        "type": "Stack",
        "children": [
          "hours",
          "days"
        ]
      },
      {
        "op": "node",
        "id": "hours",
        "type": "Slider",
        "props": {
          "label": "每天准备",
          "bind": "hours",
          "min": 0,
          "max": 8,
          "step": 0.5,
          "unit": "小时"
        }
      },
      {
        "op": "node",
        "id": "days",
        "type": "Stepper",
        "props": {
          "label": "连续准备",
          "bind": "days",
          "min": 1,
          "max": 31,
          "step": 1,
          "unit": "天"
        }
      },
      {
        "op": "node",
        "id": "details",
        "type": "Accordion",
        "props": {
          "labels": [
            "查看计算依据"
          ]
        },
        "children": [
          "formula"
        ]
      },
      {
        "op": "node",
        "id": "formula",
        "type": "Markdown",
        "props": {
          "text": "每天时长 × 准备天数。\n这是个人时间试算，不是学校规定的截止时间。"
        }
      },
      {
        "op": "end"
      }
    ]
  },
  "compare": {
    "title": "方案选择 · 先看差异",
    "intro": "示例 A 的时间投入更少，示例 B 支持线上参与。以下仅比较给定的两个维度。",
    "ops": [
      {
        "op": "begin",
        "v": 1
      },
      {
        "op": "node",
        "id": "root",
        "type": "Stack",
        "children": [
          "choices",
          "follow"
        ]
      },
      {
        "op": "node",
        "id": "choices",
        "type": "Compare",
        "props": {
          "dimensions": [
            "每周投入",
            "参与方式"
          ],
          "items": [
            {
              "label": "方案 A",
              "values": {
                "每周投入": "2 小时",
                "参与方式": "线下"
              }
            },
            {
              "label": "方案 B",
              "values": {
                "每周投入": "3 小时",
                "参与方式": "线上"
              }
            }
          ]
        }
      },
      {
        "op": "node",
        "id": "follow",
        "type": "Callout",
        "props": {
          "text": "再对照自己的课程安排决定；还缺少活动日期，暂不判断是否冲突。",
          "tone": "info"
        }
      },
      {
        "op": "end"
      }
    ]
  },
  "plan": {
    "title": "通知准备 · 行动与依据分层",
    "intro": "先核对资格，再准备材料。这里是一份工程示例清单，勾选只保存在本回答中。",
    "ops": [
      {
        "op": "begin",
        "v": 1
      },
      {
        "op": "state",
        "set": {
          "checked": []
        }
      },
      {
        "op": "node",
        "id": "tabs",
        "type": "Tabs",
        "props": {
          "labels": [
            "下一步",
            "核对依据"
          ]
        },
        "children": [
          "steps",
          "basis"
        ]
      },
      {
        "op": "node",
        "id": "steps",
        "type": "Checklist",
        "props": {
          "label": "逐项准备",
          "bind": "checked",
          "items": [
            {
              "id": "check",
              "label": "核对适用对象",
              "description": "先确认通知是否适用于自己。"
            },
            {
              "id": "files",
              "label": "备齐原件与附件",
              "description": "按通知列出的材料要求准备。"
            },
            {
              "id": "review",
              "label": "检查后再提交",
              "description": "确认期限、接收方式和文件版本。"
            }
          ]
        }
      },
      {
        "op": "node",
        "id": "basis",
        "type": "KeyValue",
        "props": {
          "items": [
            {
              "label": "正式截止时间",
              "value": "示例未提供，需对照原文"
            },
            {
              "label": "接收方式",
              "value": "示例未提供，需对照原文"
            }
          ]
        }
      },
      {
        "op": "end"
      }
    ]
  },
  "data": {
    "title": "学习记录 · 趋势与明细",
    "intro": "下面是示例数据：周一 1 小时、周二 2 小时、周三 1.5 小时。图表和明细使用同一组数值。",
    "ops": [
      {
        "op": "begin",
        "v": 1
      },
      {
        "op": "node",
        "id": "trend",
        "type": "BarChart",
        "props": {
          "label": "三天准备时长（示例）",
          "xLabel": "日期",
          "yLabel": "时长",
          "unit": "小时",
          "data": [
            {
              "x": "周一",
              "y": 1
            },
            {
              "x": "周二",
              "y": 2
            },
            {
              "x": "周三",
              "y": 1.5
            }
          ]
        }
      },
      {
        "op": "end"
      }
    ]
  }
}
