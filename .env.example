# Copy to .env. Restart after changing settings. Never commit .env.
APP_ENV=local
APP_ORIGIN=http://127.0.0.1:8765
APP_HOST=127.0.0.1
APP_PORT=8765
DATA_DIR=./data

# Qwen OpenAI-compatible endpoint. Keep all credentials on the server.
# The legacy Beijing endpoint still works; a workspace endpoint may be used.
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_MODEL=qwen3.8-flash

# 可选渠道；这些凭证与 AI、学校统一认证相互独立。仅服务端填写。
# QQ 机器人：上线后配置 HTTPS 回调 /api/integrations/qq/webhook，订阅 C2C_MESSAGE_CREATE。
QQ_BOT_APP_ID=
QQ_BOT_SECRET=
# 公众号：仅填写已经授权本项目读取文章的发布账号凭证。
WECHAT_PUBLISHER_APP_ID=
WECHAT_PUBLISHER_SECRET=
AI_API_KEY=
AI_TIMEOUT_SECONDS=90
AI_DAILY_LIMIT=30

# production requires HTTPS APP_ORIGIN, a reverse proxy, and APP_ENV=production.
# Backups contain private source files. Keep a restricted, encrypted off-host copy.
BACKUP_RETENTION_DAYS=7

# 生成式互动回答：关闭后可继续使用原有文字接口，无需回退数据库。
GENUI_ENABLED=true
GENUI_TIER=auto
GENUI_DEBUG=false
GENUI_AI_LABEL=AI 生成内容
# 根据所选服务实际能力填写，能力不足时自动降低层级；不按厂商名称判断。
AI_SUPPORTS_JSON=true
AI_SUPPORTS_TOOLS=false
AI_CONTEXT_TOKENS=32768
# 只可收紧 schema/genui/catalog.json 中的默认资源上限。
GENUI_LIMITS_JSON={}
