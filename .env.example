# Xiaomi MiMo. Default: ordinary API key and pay-as-you-go endpoint.
# Token Plan uses its dedicated tp-/ttp- key and https://token-plan-cn.xiaomimimo.com/v1.
# Do not mix credential channels. Token Plan does not include Pro UltraSpeed.
MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_TEXT_MODEL=mimo-v2.6-pro
# Explicit alternatives: mimo-v2.6-flash, mimo-v2.6-pro-ultraspeed (pay-as-you-go only).
# Never silently change the paid model or downgrade verification on provider errors.
MIMO_SUMMARY_MODEL=mimo-v2.6-flash
# Pro performs evidence analysis/review; this model composes the declarative UI.
# Pro authors the UI graph and state transitions; Flash can be compared explicitly.
MIMO_COMPOSITION_MODEL=mimo-v2.6-pro
MIMO_ASR_MODEL=mimo-v2.5-asr
MIMO_TTS_MODEL=mimo-v2.5-tts
MIMO_VOICE_DESIGN_MODEL=mimo-v2.5-tts-voicedesign
MIMO_VOICE_CLONE_MODEL=mimo-v2.5-tts-voiceclone
MIMO_TTS_VOICE=mimo_default

# Copy to .env. Restart after changing settings. Never commit .env.
APP_ENV=local
APP_ORIGIN=http://127.0.0.1:8765
APP_HOST=127.0.0.1
APP_PORT=8765
DATA_DIR=./data
# public preserves open signup; set invite for the MVP's invited pilot.
# Existing accounts can still log in; create invitations with manage.py invite.
REGISTRATION_MODE=public


# 可选渠道；这些凭证与 AI、学校统一认证相互独立。仅服务端填写。
# QQ 机器人：上线后配置 HTTPS 回调 /api/integrations/qq/webhook，订阅 C2C_MESSAGE_CREATE。
QQ_BOT_APP_ID=
QQ_BOT_SECRET=
# 公众号：仅填写已经授权本项目读取文章的发布账号凭证。
WECHAT_PUBLISHER_APP_ID=
WECHAT_PUBLISHER_SECRET=
# 单次 HTTP 读取等待；收到数据后重新计时。
AI_TIMEOUT_SECONDS=180
# 所有 MiMo 文字阶段共用的最大输出，含思考与正文；官方 128K = 131072。
AI_OUTPUT_TOKENS=131072
# 整轮检索、生成、独立核验及修正的总时间上限，支持随时停止或补充转向。
AI_WORKFLOW_TIMEOUT_SECONDS=1800
AI_DAILY_LIMIT=1000
# 校园账号容量，可按部署规模覆盖单项；存储量单位为字节。
USAGE_LIMITS_JSON={}
# 通知整理的保守输入预算；包括提示词、原文、字段结构及图片估算。
# 超限会在外发前拒绝并保留原件，不静默截断；这不是实际计费 token 数。
NOTICE_INPUT_TOKENS=868928
# 严格证据流程：检索本人资料与日程、按需真实联网、逐字引文检查、独立复核。
# 一次回答可能有多次模型/搜索计费；未通过核验的草稿不向用户发布。
AI_GROUNDING=true
# 阶段进度默认直接使用真实执行状态，不为改写提示语额外调用模型。
AI_STAGE_SUMMARIES=false

# production requires HTTPS APP_ORIGIN, a reverse proxy, and APP_ENV=production.
# Backups contain private source files. Keep a restricted, encrypted off-host copy.
# 自动备份保留天数（默认 7）。注销账号后，已有自动备份中的数据在到期轮换时清除；隐私政策展示同一数值。
BACKUP_RETENTION_DAYS=7

# 隐私政策和用户协议中展示的运营者名称与联系方式（名称最多 80 字，联系方式最多 120 字）。
# 部署前请填写真实信息；联系方式留空时，页面显示“部署管理员公布的联系方式”。
OPERATOR_NAME=珞珈信使项目团队
OPERATOR_CONTACT=

# 声音复刻默认关闭。开启前，部署方必须先建立被复刻人的书面授权流程，并评估深度合成相关规定。
# 关闭时复刻请求直接被拒绝，普通播报与音色设计不受影响。
VOICE_CLONE_ENABLED=false

# 生成式互动回答：关闭后可继续使用原有文字接口，无需回退数据库。
GENUI_ENABLED=true
GENUI_TIER=auto
GENUI_DEBUG=false
GENUI_AI_LABEL=AI 生成内容
# 根据所选服务实际能力填写，能力不足时自动降低层级；不按厂商名称判断。
AI_SUPPORTS_JSON=true
AI_SUPPORTS_TOOLS=false
# MiMo V2.6 Pro 的 1M 窗口；是允许容量，不会自动填满每次请求。
AI_CONTEXT_TOKENS=1000000
# 只可收紧 schema/genui/catalog.json 中的默认资源上限。
GENUI_LIMITS_JSON={}

# 通知提取后独立核对责任、手续、材料与前置；每次最多两个请求，无自动重试。
NOTICE_SEMANTIC_REVIEW=true
MIMO_NOTICE_REVIEW_MODEL=mimo-v2.6-flash
# 仅普通按量 API 可用；开启后用户可逐次选择费用更高的加速模式，不改变默认模型。
NOTICE_FAST_ENABLED=false

# 现有聊天 Agent 工具循环：采集资料后继续原有回答生成与独立证据核验。
AGENT_ENABLED=true
# UTF-8 字节预算；执行器还会按模型上下文减去输出保留量进一步收紧。
AGENT_CONTEXT_BYTES=2000000
# 仅使用回环地址的 OpenAI-compatible chat/completions；空模型名表示未配置。
# Ollama: http://127.0.0.1:11434/v1；LM Studio: http://127.0.0.1:1234/v1
AGENT_OSS_URL=http://127.0.0.1:11434/v1
AGENT_OSS_MODEL=
AGENT_OSS_CONTEXT_TOKENS=32768
# 命令执行须使用本机已有、带 @sha256: 摘要的 Docker 镜像；空值拒绝执行。
# 容器无网络，工作区与根文件系统只读；文件写入通过单独的审批工具完成。
AGENT_SANDBOX_IMAGE=
# MCP Streamable HTTP，仅配置维护者明确允许的工具；每次调用需本人批准。
# 示例：{"campus":{"url":"https://mcp.example.edu/mcp","tools":["lookup"],"token_env":"AGENT_MCP_CAMPUS_TOKEN"}}
AGENT_MCP_SERVERS_JSON={}
